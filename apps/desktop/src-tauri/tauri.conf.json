{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assentor Desktop",
  "version": "0.3.19",
  "identifier": "dev.masterakbari.assentor",
  "build": {
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Assentor Desktop", "width": 1180, "height": 760, "minWidth": 720, "minHeight": 500, "devtools": false }],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["assentor"] } },
    "updater": { "pubkey": "" }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Run and review local AI-assisted coding sessions",
    "externalBin": ["binaries/assentor-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../package.json": "engine-resources/package.json",
      "../../../prompts/builtin/": "engine-resources/prompts/builtin/",
      "../../../playbooks/builtin/": "engine-resources/playbooks/builtin/",
      "../../../skills/": "engine-resources/skills/"
    }
  }
}
