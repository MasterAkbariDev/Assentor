{
  "name": "assentor",
  "version": "0.3.19",
  "description": "Local supervisor CLI that coordinates AI coding agents with evidence-based review",
  "type": "module",
  "bin": {
    "assentor": "./bin/assentor"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#assentor/protocol/*": "./dist/protocol/*",
    "#assentor/ui-shared/*": "./dist/ui-shared/*",
    "#assentor/engine/*": "./dist/*"
  },
  "files": [
    "dist",
    "bin",
    "prompts",
    "playbooks",
    "skills",
    "packages/ui/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && vite build --config packages/ui/vite.config.ts",
    "build:ui": "vite build --config packages/ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json && tsc -p packages/ui/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-cli": "./scripts/install-cli.sh",
    "assentor": "./bin/assentor",
    "screenshots": "npm run build && node scripts/capture-tui-screens.mjs",
    "bench:tokens": "node scripts/bench-tokens.mjs",
    "perf:streaming": "node scripts/perf/streaming.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "cli",
    "assentor",
    "code-review",
    "supervisor"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "ws": "^8.21.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "postject": "1.0.0-alpha.6",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.8",
    "zustand": "^5.0.16"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterAkbariDev/Assentor.git"
  },
  "bugs": {
    "url": "https://github.com/MasterAkbariDev/Assentor/issues"
  },
  "homepage": "https://github.com/MasterAkbariDev/Assentor#readme"
}
