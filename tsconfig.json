{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    // Workspace packages import each other through the root package.json "imports".
    "paths": {
      "#assentor/protocol/*": ["./packages/protocol/src/*"],
      "#assentor/ui-shared/*": ["./packages/ui-shared/src/*"],
      "#assentor/engine/*": ["./packages/engine/src/*"]
    }
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/ui-shared/src/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/src/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
